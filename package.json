{
  "name": "agentboard",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/shared",
    "packages/contracts",
    "packages/agent",
    "packages/web"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=packages/agent\" \"npm run dev --workspace=packages/web\"",
    "build": "npm run build --workspace=packages/shared && npm run build --workspace=packages/contracts && npm run build --workspace=packages/agent && npm run build --workspace=packages/web",
    "test": "npm run test --workspace=packages/contracts",
    "lint": "eslint packages/*/src --ext .ts,.tsx"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.3.3"
  }
}
